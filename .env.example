# Copie para .env e configure sua própria chave. Não publique o arquivo .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
PORT=3070
HOST=127.0.0.1
DATA_DIR=./data/real
DEMO=false
# npm run demo usa esta pasta, independente de DATA_DIR.
DEMO_DATA_DIR=./data/demo
# Para HTTPS atrás de proxy, configure a origem exata e cookies seguros.
# APP_ORIGIN=https://seu-dominio.example
SECURE_COOKIES=false
